/* Privātās atslēgas — PARAUGS.
 *
 * Nokopē šo failu uz `secrets.js` (TAJĀ PAŠĀ mapē, kur atrodas package.json —
 * NE uz config/) un ieraksti savas vērtības. `secrets.js` netiek pievienots
 * git (skat. .gitignore), tāpēc atslēgas nekad nenokļūst repozitorijā.
 *
 * Kāpēc ne config/: MagicMirror atdod mapi config/ (un modules/) pa HTTP kā
 * statiskus failus, t.i. jebkurš ierīce tīklā varētu atvērt
 * http://<pi-ip>:8080/config/secrets.js un nolasīt atslēgas. Šeit tās nav
 * pieejamas pa HTTP, un tās ielasa tikai moduļu node_helper (servera puse) —
 * ne config.js, jo arī config.js tiek nosūtīts pārlūkam.
 */
module.exports = {
	// Spotify tagad var pieslēgt no telefona (tālvadība -> Spotify, lapa /spotify) —
	// tad šeit nekas nav jāraksta. Šis ir vecais veids (skat. MMM-SpotifyNowPlaying README).
	spotify: {
		clientId: "",
		clientSecret: "",
		refreshToken: ""
	},
	google: {
		// Google Cloud Console -> OAuth client (tips "TV and Limited Input
		// Devices") -> Client ID / Client secret. Skat.
		// modules/MMM-GoogleCalendar/README.md. Pats pieslēgšanās solis
		// (kalendāra atļauja) notiek uz spoguļa ekrāna ar kodu — te vajadzīgs
		// tikai vienreiz uzstādīts OAuth klients, ne personiskā atļauja.
		oauthClientId: "",
		oauthClientSecret: ""
	},
	// Outlook / Microsoft 365 (vai jebkurš cits ICS) kalendārs. Outlook.com:
	// Iestatījumi -> Kalendārs -> Koplietotie kalendāri -> Publicēt kalendāru ->
	// "Var skatīt visu informāciju" -> nokopē ICS saiti. Saite satur slepenu
	// atslēgu — tāpēc šeit, ne config.js. Skat. modules/MMM-GoogleCalendar/README.md.
	calendarFeeds: [
		// { name: "Outlook", url: "https://outlook.office365.com/owa/calendar/…/calendar.ics" }
	]
};
